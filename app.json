{
  "expo": {
    "name": "Big Bowl",
    "slug": "BigBowl",
    "homepage": "https://bigbowl.superjeffc.com",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/bigbowl.png",
    "scheme": "bigbowl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bigbowl.png",
        "backgroundImage": "./assets/images/bigbowl.png",
        "monochromeImage": "./assets/images/bigbowl.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jeffreychan.bigbowl"
    },
    "web": {
      "output": "static",
      "baseUrl": "/",
      "favicon": "./assets/images/bigbowl.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bigbowl.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f76cda09-1226-4c3d-88fc-b4725c9e8e6e"
      }
    }
  }
}
