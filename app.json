{
  "expo": {
    "name": "BigBowl",
    "slug": "BigBowl",
    "homepage": "https://superjeffreyc.github.io/Big-Bowl",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/bigbowl.png",
    "scheme": "bigbowl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bigbowl.png",
        "backgroundImage": "./assets/images/bigbowl.png",
        "monochromeImage": "./assets/images/bigbowl.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bunder": "metro",
      "publicPath": "/Big-Bowl/",
      "output": "static",
      "favicon": "./assets/images/bigbowl.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bigbowl.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Big-Bowl/"
    }
  }
}
